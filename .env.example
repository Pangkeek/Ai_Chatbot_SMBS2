PORT=3000
# PostgreSQL is the only application runtime database.
DATABASE_URL=postgresql://chatbot:local-development-only@127.0.0.1:55432/chatbot_dev
TEST_DATABASE_URL=postgresql://chatbot:local-development-only@127.0.0.1:55432/chatbot_test
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_SSL_MODE=disable
DB_SCHEMA=public
# SQLite tooling only; never used by the application runtime.
DATABASE_PATH=./data/chatbot.sqlite
# Set explicitly to a completed backup snapshot with adjacent manifest.json.
# SQLITE_SOURCE_PATH=./data/backups/sqlite-<id>/snapshot.sqlite
SQLITE_IMPORT_BATCH_SIZE=200
DB_IMPORT_QUERY_TIMEOUT_MS=60000
# Enable only in the server process that should consume durable LINE jobs.
LINE_WORKER_ENABLED=false
APP_MAINTENANCE_MODE=false
# Optional provider-neutral AI service; omit for offline extractive answers.
# RAG_GENERATOR_URL=https://your-ai-service.example/generate
# RAG_GENERATOR_TOKEN=replace-me

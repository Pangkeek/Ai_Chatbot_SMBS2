{
  "name": "smb-chatbot-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant chatbot foundation and API contract",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
 "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --test",
    "api:generate": "node scripts/openapi.mjs",
    "api:check": "node scripts/openapi.mjs --check",
    "css:build": "npx @tailwindcss/cli -i ./public/input.css -o ./public/app.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./public/input.css -o ./public/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}

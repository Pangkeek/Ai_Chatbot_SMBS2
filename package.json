{
  "name": "smb-chatbot-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "type": "module",
  "description": "Multi-tenant chatbot foundation and API contract",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "next start --hostname 0.0.0.0",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "rag:reindex": "node --env-file-if-exists=.env scripts/reindex-knowledge.js",
    "test": "node --test",
    "api:generate": "node scripts/openapi.js",
    "api:check": "node scripts/openapi.js --check"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}

# คัดลอกเป็น .env เพื่อเชื่อม PostgreSQL local ที่แยกจาก Compose เดิม
DATABASE_URL=postgresql://chatbot:local-development-only@127.0.0.1:55434/chatbot_local
TEST_DATABASE_URL=postgresql://chatbot:local-development-only@127.0.0.1:55434/chatbot_test
DB_SSL_MODE=disable
DB_SCHEMA=public
LINE_WORKER_ENABLED=false
APP_MAINTENANCE_MODE=false
# ใส่คีย์ของตนเองเฉพาะเมื่อต้องการเรียก AI จริง
# GEMINI_API_KEY=
# OPENAI_API_KEY=
